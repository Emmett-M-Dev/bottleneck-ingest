# Credentials — never committed
credentials/

# Real client data — never committed
data/real/

# Remediation output (cleaned copies of the messy drives — regenerated)
data/synthetic/*_cleaned/

# Simulator state (state.json + generated .xlsx drive, regenerated by
# `simulator.cli --reset` / `--advance`) — never commit generated binaries
data/sim/

# Pipeline outputs (regenerated)
outputs/
refresh.log

# Python
*.pyc
__pycache__/
.env

# Virtual environment
.venv/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Agent / tooling
.claude/
